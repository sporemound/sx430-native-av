-- SX430 IS 1.00B only. Loaded by the PC test runner, not an SD autostart script.
assert(sx430_ptpip_test==true,'Start this generated candidate using the documented PC host command')
local b=get_buildinfo()
assert(b.platform=='sx430is' and b.platsub=='100b' and b.platformid==13013,'Wrong camera')
assert(tostring(b.build_revision)=='6357','Unreviewed CHDK build')
assert(type(peek)=='function' and type(call_func_ptr)=='function','Required CHDK APIs unavailable')
assert(get_config_value(1999)==1,'Enable Lua native calls in CHDK Miscellaneous Stuff first')

-- FIRMWARE_WORDS_BEGIN
local firmware_words={}
assert(#firmware_words==381,"Generate this candidate from a locally verified ROM first")
-- FIRMWARE_WORDS_END
for _,v in ipairs(firmware_words) do
    assert(peek(v[1],4)==v[2],'Firmware instruction mismatch; stopping before mode request')
end

local f=assert(io.open('A/WFNATIVE.CSV','a'))
local lines={}
local function emit(s) f:write(s,'\n');f:flush();lines[#lines+1]=s end
local function word(a) return assert(peek(a,4),'Memory read failed') end
local function snapshot(phase)
    local r,v,m=get_mode()
    local pr,cc,flag,pending=word(0x3ac8),word(0x23cc),word(0x2410),word(0x2414)
    emit(table.concat({phase,get_tick_count(),tostring(r),tostring(v),m,pr,cc,get_vbatt(),flag,pending,word(0x28d4),word(0x25848),word(0x3d34)},','))
    return r,v,pr,cc,flag,pending
end
function restore()
    -- No native calls or state changes in the interruption handler.
    if f then f:write('INTERRUPTED\n');f:close();f=nil end
end
emit('BEGIN_NATIVE_MODE_CANDIDATE,sx430is,100b,6357')
emit('phase,tick_ms,chdk_record,chdk_video,chdk_mode,playrec_word,cameracon_word,battery_mV,playback_flag_2410,camera_flag_2414,wifi_flag_28d4,control_word_25848,override_enabled_3d34')
local requested=false
local function run()
    local r,v,pr,cc,flag=snapshot('initial')
    -- Pairing can finish while InitPB (state 9) is still settling.
    for i=1,20 do
        if cc~=9 then break end
        assert(not r and not v and pr==3,'Unexpected playback initialization')
        sleep(100)
        r,v,pr,cc,flag=snapshot('wait_initial_playback')
    end
    assert(not r and not v and (pr==0 or pr==3) and cc==2 and flag==1,'Unexpected initial state')
    assert(get_vbatt()>=3500,'Charge the battery before this test')
    sleep(300)
    r,v,pr,cc,flag=snapshot('before_request')
    assert(not r and not v and (pr==0 or pr==3) and cc==2 and flag==1,'Initial state changed')
    switch_mode_usb(true)
    requested=true
    sleep(100)
    r,v,pr,cc,flag=snapshot('before_native_handler')
    local transition=(cc==12 and pr==3) or (cc==8 and pr==1)
    assert(not r and not v and transition and flag==1,'Transition guard refused native call')
    -- Owner ROM 0xff05f154, r0=ModeDialToCamera, r1=0.
    -- Bounded instruction execution verifies this input writes only 0x2410=0
    -- and 0x2414=1 outside its stack. No firmware subroutines are called.
    -- Return register has no success contract; verify the actual RAM result.
    call_func_ptr(0xff05f154,0x105f,0)
    local _,_,_,_,after,pending=snapshot('after_native_handler')
    assert(after==0 and pending==1,'Handler result was not observed')
    local consecutive,best=0,0
    for i=1,60 do
        sleep(100)
        r,v,pr,cc=snapshot('observe')
        assert(not v,'Unexpected movie recording state')
        if r and pr==2 and cc==1 then consecutive=consecutive+1 else consecutive=0 end
        if consecutive>best then best=consecutive end
    end
    emit('MAX_CONSECUTIVE_RECORD_SAMPLES,'..best)
    -- At least 3 seconds, sampled at 100 ms. This is a short mode test only.
    emit('RESULT,'..(best>=30 and 'STABLE_RECORD_OBSERVED' or 'NO_STABLE_RECORD'))
end
local ok,err=pcall(run)
if not ok then emit('ERROR,'..tostring(err):gsub('[\r\n]',' ')) end
-- A mode request can finish after a refused guard. Give it time to settle,
-- then use only the normal PTP return operation if both raw words agree.
if requested then
    if not ok then for i=1,20 do sleep(100);snapshot('error_settle') end end
    local r,v,pr,cc=snapshot('before_cleanup')
    if not v and pr==2 and cc==1 then
        switch_mode_usb(false)
        for i=1,20 do sleep(100);snapshot('return_playback') end
    else
        emit('CLEANUP,NO_REDUNDANT_PLAYBACK_REQUEST')
    end
end
emit('DONE')
f:close();f=nil
return table.concat(lines,'\n')..'\n'
